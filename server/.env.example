# Copy to server/.env and replace every placeholder.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops (use 1 behind nginx/ALB, false when direct).
TRUST_PROXY=1
RECURRING_CRON=*/15 * * * *
